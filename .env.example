# Copy to .env.local for local dev. Every variable the app can read is
# documented here, even ones not consumed until a later build phase — see
# PHASES.md for which phase wires each one up. Nothing here is a secret;
# real values must never be committed.

# --- Tenant / site (Phase 0+) ---
# Which tenant config in tenants/*.ts this deployment serves by default.
NEXT_PUBLIC_TENANT=harbison
# Public site URL. No domain purchased yet — leave the placeholder until
# the client buys one; never hardcode a URL in code instead of using this.
NEXT_PUBLIC_SITE_URL=https://example-harbison-standard.placeholder

# --- Supabase (Phase 2+) ---
# Project URL and anon key are safe for the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used exclusively in route handlers/cron — never exposed to
# the client. Bypasses RLS: treat as a root credential.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (Phase 3+) ---
# If RESEND_API_KEY is absent, sends are logged to console + an
# outreach_log row instead of failing (see §3 graceful-degradation rule).
# The lead still saves.
RESEND_API_KEY=
# Must be an address on a domain you've verified with Resend via DNS —
# you cannot send as an arbitrary Gmail/Outlook/etc. address. Falls back
# to the tenant's contact email (tenants/harbison.ts) if unset, which
# will make Resend reject the send until a real domain is verified.
# e.g. leads@theharbisonstandard.com
RESEND_FROM_EMAIL=

# --- Twilio: not wired up yet, by operator request (see DECISIONS.md) ---
# Missed-call text-back (§7.4) currently ships as a working example
# against mock data — lib/twilio.ts always logs the would-be SMS instead
# of sending one, with no env vars to set. When a Twilio account exists,
# re-add the `twilio` npm package and the TWILIO_ACCOUNT_SID/AUTH_TOKEN/
# PHONE_NUMBER variables (see git history for lib/twilio.ts's prior
# implementation and app/api/webhooks/twilio/route.ts's signature-
# verification comment for what to restore).

# --- Cron (Phase 3+) ---
# Shared secret required in the Authorization header of requests to
# /api/cron/briefing. Generate with `openssl rand -hex 32`.
CRON_SECRET=
